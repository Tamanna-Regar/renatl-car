# Required in production. Keep this value private and stable across restarts.
AUTH_SECRET=replace-with-a-long-random-secret

# Required for live Stripe payments. Leave empty for local development.
STRIPE_SECRET_KEY=

# Required for production GPS/IoT telemetry ingestion.
# Leave empty only for local development.
DEVICE_API_KEY=

# Optional live traffic routing provider.
MAPBOX_ACCESS_TOKEN=

# Required for verified Stripe webhook events.
STRIPE_WEBHOOK_SECRET=
